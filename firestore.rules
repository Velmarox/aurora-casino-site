rules_version = '2';

/* ============================================================================
   Aurora Casino - Firestore security rules

   One document and nothing else:

     site/config    what the owner can change about the public site (promos,
                    notice bar, social links, show/hide). World readable,
                    because the homepage fetches it on every visit. Writable
                    only by the owner account.

   The contact form inbox (messages/*) was removed in v0.4.0-alpha along with
   the dashboard's Messages tab; anything under it is now denied.

   The owner is named by UID below (Firebase Console > Authentication > Users).
   ========================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    /* The one account allowed to change anything. A UID allowlist rather than
       "any signed-in user", because if signup is ever left open by accident,
       "any signed-in user" means anyone on the internet. */
    function isOwner() {
      return request.auth != null
          && request.auth.uid in ['pXylZ2BJrtRvi8TRXXCa83JOhMT2'];
    }

    /* ---- public site config ---- */
    match /site/config {
      allow read: if true;
      allow write: if isOwner();
    }

    /* Anything not named above is denied. Without this a future collection
       created by accident would inherit nothing and be wide open to confusion. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
